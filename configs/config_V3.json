{
  "project": {
    "name": "EfficientCaps — Degraded Traffic Sign Recognition",
    "author": "Mansoureh Fahimi",
    "version": "V3"
  },
  "model": {
    "name": "EfficientCaps",
    "pretrained": false,
    "num_classes": 43,
    "img_size": 48,
    "primary_caps": 32,
    "primary_dim": 8,
    "class_dim": 16,
    "backbone": [
      "Conv2d(3, 64, kernel=5, stride=1, padding=2) + BN + ReLU",
      "DepthwiseSeparableConv(64, 128, stride=2)",
      "DepthwiseSeparableConv(128, 256, stride=2)"
    ]
  },
  "training": {
    "seed": 42,
    "batch_size": 128,
    "num_epochs": 30,
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "lr_scheduler": "CosineAnnealingLR",
    "reconstruction_weight": 0.0005,
    "conf_threshold": 0.60,
    "val_split": 0.10
  },
  "loss": {
    "type": "WeightedMarginLoss + ReconstructionLoss",
    "margin_plus": 0.9,
    "margin_minus": 0.1,
    "alpha": 0.5,
    "hard_class_weights": {
      "30": 3.0,
      "41": 3.0,
      "23": 2.5,
      "19": 2.0,
      "20": 2.0,
      "21": 2.0,
      "27": 2.0,
      "22": 1.5,
      "18": 1.5,
      "0": 1.5
    }
  },
  "dataset": {
    "name": "tanganke/gtsrb",
    "source": "HuggingFace",
    "num_classes": 43,
    "train_size": 39209,
    "test_size": 12630,
    "cache_path": "TrafficSign_EfficientCaps/cashe/",
    "normalization": {
      "mean": [0.3337, 0.3064, 0.3171],
      "std": [0.2672, 0.2564, 0.2629]
    }
  },
  "augmentation": {
    "standard": {
      "random_affine": {"degrees": 15, "translate": [0.1, 0.1], "scale": [0.85, 1.15]},
      "color_jitter": {"brightness": 0.4, "contrast": 0.4, "saturation": 0.3, "hue": 0.05},
      "random_grayscale_p": 0.05,
      "gaussian_blur": {"kernel_size": 3, "sigma": [0.1, 1.5]}
    },
    "hard_class_augmentation": {
      "enabled": true,
      "probability": 0.70,
      "hard_classes": [30, 41, 23, 19, 20, 21, 27, 18, 22, 0],
      "random_affine": {"degrees": 20, "translate": [0.12, 0.12], "scale": [0.80, 1.20]},
      "color_jitter": {"brightness": 0.6, "contrast": 0.6, "saturation": 0.5, "hue": 0.08},
      "random_grayscale_p": 0.10,
      "gaussian_blur": {"kernel_size": 3, "sigma": [0.1, 2.5]},
      "random_perspective": {"distortion_scale": 0.15, "p": 0.4}
    },
    "balanced_sampler": {
      "enabled": true,
      "type": "WeightedRandomSampler",
      "replacement": true
    }
  },
  "results": {
    "best_val_accuracy": 99.06,
    "macro_f1": 96.5,
    "best_epoch": 30,
    "classes_f1_above_95": 33,
    "classes_f1_80_to_95": 10,
    "classes_f1_below_80": 0,
    "real_world_accuracy": 51.5,
    "real_world_correct": 17,
    "checkpoint_path": "TrafficSign_EfficientCaps_V3/EfficientCaps/checkpoints/best_model.pt"
  }
}
